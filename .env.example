# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional overrides of the confirmed public config in src/newFirebaseConfig.ts.
# If overriding, fill all five fields together. Otherwise leave them blank.
# Never use chromatic-pride-0ttsj here. No fallback writes to the old project.
VITE_NEW_FIREBASE_PROJECT_ID=""
VITE_NEW_FIREBASE_API_KEY=""
VITE_NEW_FIREBASE_APP_ID=""
VITE_NEW_FIREBASE_AUTH_DOMAIN=""
VITE_NEW_FIREBASE_DATABASE_ID=""
# Server verification defaults to the confirmed new project. An override must match the client.
FIREBASE_PROJECT_ID="gen-lang-client-0958943545"
ADMIN_ACCESS_KEY="JULI123"
ADMIN_FIREBASE_EMAIL=""
ADMIN_FIREBASE_PASSWORD=""
